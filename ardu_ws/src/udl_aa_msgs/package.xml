<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>udl_aa_msgs</name>
  <version>0.1.0</version>
  <description>
    Message definitions for the ArduPilot autonomy stack: the vehicle telemetry
    snapshot, and the command/status pair exchanged between fs_adapter and the
    flight commander.
  </description>
  <maintainer email="hello@usefuldynamics.io">Your Name</maintainer>
  <license>MIT</license>

  <!-- Message generation needs ament_cmake; it cannot run from a setup.py
       package, which is why these live here rather than in udl_aa_fs. -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>std_msgs</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
